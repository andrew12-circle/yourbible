@@ -136,17 +136,20 @@ export function getVerseBodyElement(
-/** Character offset within `body` for a range boundary. */
-export function offsetInVerseBody(
-  body: HTMLElement,
-  container: Node,
-  offset: number,
-): number {
-  const r = document.createRange();
-  r.selectNodeContents(body);
