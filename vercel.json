{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key":"X-Content-Type-Options","value":"nosniff"},
        {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
        {"key":"Permissions-Policy","value":"camera=(self), microphone=(self), geolocation=(self), display-capture=(self)"},
        {"key":"Strict-Transport-Security","value":"max-age=63072000; includeSubDomains; preload"}
      ]
    },
    {"source":"/((?!youtube-player\\.html$).*)","headers":[{"key":"X-Frame-Options","value":"DENY"}]},
    {"source":"/site.webmanifest","headers":[{"key":"Cache-Control","value":"no-cache, must-revalidate"}]},
    {"source":"/app-icon-(.*)","headers":[{"key":"Cache-Control","value":"public, max-age=0, must-revalidate"}]},
    {
      "source":"/youtube-player.html",
      "headers":[
        {"key":"Cache-Control","value":"no-cache, must-revalidate"},
        {"key":"Content-Security-Policy","value":"default-src 'none'; script-src 'self' https://www.youtube.com https://s.ytimg.com; style-src 'self'; frame-src https://www.youtube.com; connect-src https://www.youtube.com; frame-ancestors 'self' capacitor://localhost http://localhost https://localhost; base-uri 'none'; form-action 'none'"}
      ]
    }
  ],
  "rewrites":[
    {
      "source":"/((?!api/|visual-bible/|bible-plates/|youtube-player\\.(?:html|js|css)$|assets/|app-icon|icon-|favicon|apple-touch|site\\.webmanifest|framework-icon|robots\\.txt|placeholder|artifact-video-popout\\.html).*)",
      "destination":"/index.html"
    }
  ],
  "functions":{"api/youtube-captions.ts":{"maxDuration":30}}
}
